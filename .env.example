MONGO_URI=mongodb+srv://utilisateur:motdepasse@cluster.exemple.mongodb.net/elite-runners
PORT=5000
# Aléatoire, 64 caractères : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Domaine(s) du front autorisés à appeler l'API, séparés par des virgules
CORS_ORIGIN=https://mon-front.exemple.com
# Nombre de proxys devant l'API (3 sur Render d'après la communauté Render, 1 sur Railway/Heroku)
TRUST_PROXY=3
# Fuseau horaire du club, pour savoir quel jour est « aujourd'hui » dans les streaks
CLUB_TZ=America/Toronto
